# Canonical business address. Previews stay noindex regardless of this setting.
NEXT_PUBLIC_SITE_URL=https://jdshorseranch.com
# SEO_INDEXING_ENABLED=true  # only at an approved, verified canonical cutover
# Vercel project: prj_pIWeP2s571lCryqRL7Zv5nYSa3SI

# Separate Turso databases and tokens for Preview and Production.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=

# Generate securely with scripts/admin-credentials.mjs. Never use example passwords.
ADMIN_PASSWORD_HASH_V2=
ADMIN_PASSWORD_SALT_V2=
SESSION_TOKEN_SECRET_V2=
CRON_SECRET=

# Square starts in Sandbox. Set production only after real account certification.
SQUARE_ENVIRONMENT=sandbox
# SQUARE_PRODUCTION_ENABLED=true  # live payments only after payment acceptance
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_API_VERSION=2026-09-16
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://your-preview-host/api/square/webhook

# Optional owner photo uploads. Built-in ranch photographs need no storage service.
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_SERVICE_ROLE_KEY=

# Optional JD-owned GA4 property. Public ID; never send private/rider data to GA4.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Optional Google Calendar. Use the exact origin of this deployment for the callback.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://your-preview-host/api/admin/calendars/google/callback
CALENDAR_ENCRYPTION_KEY=

# Optional Firebase owner push notifications (all fields required for activation).
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Current conservative capacity: one group at a time and a 15-minute gap.
RANCH_BOOKING_BUFFER_MINUTES=15

# RANCH_ALLOW_LOCAL_DB and RANCH_TEST_FIXTURES are generated only by acceptance
# tests. They must never be configured on Vercel or in a shared deployment.
