# Public site
NEXT_PUBLIC_SITE_URL=https://jdshorseranch.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=

# Admin
# ADMIN_PASSWORD_HASH supports legacy SHA-256 when ADMIN_PASSWORD_SALT is blank.
# For new deployments, set ADMIN_PASSWORD_SALT and store the matching scrypt hash.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SALT=
SESSION_TOKEN_SECRET=

# WhatsApp Cloud API
NEXT_PUBLIC_WHATSAPP_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_PAYMENT_TEMPLATE_NAME=
WHATSAPP_DECLINE_TEMPLATE_NAME=
WHATSAPP_CONFIRMATION_TEMPLATE_NAME=
WHATSAPP_REMINDER_TEMPLATE_NAME=
WHATSAPP_EXPIRED_TEMPLATE_NAME=
WHATSAPP_FOLLOWUP_TEMPLATE_NAME=

# Optional SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_SMS_WEBHOOK_URL=https://jdshorseranch.com/api/sms/webhook

# Square Checkout
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_API_VERSION=2026-09-16
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://jdshorseranch.com/api/square/webhook

# Lifecycle / follow-up
CRON_SECRET=
JD_REVIEW_URL=

# Optional: Firebase for legacy push notifications
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
