{
  "name": "jds-horse-ranch-pwa",
  "version": "1.1.0",
  "description": "JD's Horse Ranch reservation PWA with governed booking intake, JD approval, messaging, and verified Square checkout",
  "author": "DevSolo",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "npm run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml}\"",
    "db:migrate": "node scripts/turso-migrate.mjs",
    "db:migrate:legacy": "node scripts/migrate-supabase-to-turso.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "next": "15.5.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@libsql/client": "0.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.24",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "nanoid": "3.3.19"
  }
}
